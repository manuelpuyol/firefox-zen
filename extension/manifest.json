{
  "manifest_version": 3,
  "name": "Zen Folder Tools",
  "version": "0.2.0",
  "description": "Zen-style extras for Firefox: keep empty folders, reset folder tabs to their original URL, and Glance (Alt+click a link to preview it in a floating window).",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "tabs",
    "tabHide",
    "sessions",
    "menus",
    "storage"
  ],
  "background": {
    "scripts": [
      "folders.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "glance-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "reset-tab": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Reset the current folder tab to its original URL"
    },
    "glance-expand": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Open the current Glance as a regular tab"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-folder-tools@manuelpuyol.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
