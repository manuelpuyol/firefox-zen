{
  "manifest_version": 3,
  "name": "Zen Folder Tools",
  "version": "0.9.2",
  "description": "A Zen-style tab sidebar for Firefox: Essentials, kept tabs in nested folders, and regular tabs. Closing a kept tab unloads it, idle tabs unload automatically, and Alt+click previews a link in a Glance.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "sessions",
    "menus",
    "menus.overrideContext",
    "storage",
    "alarms",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/settings.js",
      "lib/model.js",
      "lib/unload.js",
      "background.js"
    ]
  },
  "commands": {
    "reset-tab": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Reset the current kept tab to its original URL"
    },
    "glance-expand": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Open the current Glance as a regular tab"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-folder-tools@manuelpuyol.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "Zen Tabs",
    "default_icon": "icons/icon.svg",
    "open_at_install": true
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
