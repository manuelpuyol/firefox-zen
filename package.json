{
  "name": "firefox-zen",
  "private": true,
  "description": "Tests for the Zen Folder Tools extension.",
  "scripts": {
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project unit --coverage",
    "lint": "eslint . && web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.1.0",
    "@webext-core/fake-browser": "^2.0.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "selenium-webdriver": "^4.52.0",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  },
  "type": "module"
}
